#!/usr/bin/env bash
# ai-task: a manual agent loop for teams without a coding agent.
#
# The model works in a chat window; this script is its hands. It packs repo
# context into one file to upload, applies the change bundle the model sends
# back, runs your checks, and keeps an audit trail in .ai/tasks/.
#
# Tasks are Beads issues (https://github.com/steveyegge/beads) when the bd CLI
# is installed and the repository has a .beads/ directory: ids, dependencies
# and the ready queue come from bd. Without bd, tasks get local ids.
#
# Needs only bash, git and standard Unix tools (works in Git Bash on Windows).
# Run it from inside the project you are working on, not from this repo.
set -euo pipefail

VERSION="0.1.0"

die()  { echo "ai-task: $*" >&2; exit 1; }
note() { echo "ai-task: $*" >&2; }

usage() {
  cat <<'EOF'
ai-task - pack context for a chat model, apply its changes, check, repeat

  ai-task init                       set up .ai/ in the current git repository
  ai-task new "<title>" [-t type] [-p priority]
                                     create a bead (or a local task) and its folder
  ai-task plan <plan.json>           create beads with dependencies from a plan file
  ai-task next                       claim the next ready bead and start working on it
  ai-task pack [ID] [paths...]       write context.md for the task (upload it to the chat)
        --review                     ask for a code review of the task's changes instead of new code
  ai-task apply [ID] [file|-]        apply the model's change bundle on branch ai/<id>
        --paste                      read the bundle from the clipboard
        --no-commit                  leave the changes uncommitted
  ai-task check [ID] [-- command]    run CHECK_CMD (or the given command), save check.log
  ai-task feedback [ID] [--copy]     write feedback.md to paste back into the chat
  ai-task done [ID] ["reason"]       close the bead after a passing check
  ai-task status                     list tasks
  ai-task report                     per-task rounds, pass/fail and elapsed time

ID is a bead id such as bd-a1b2; it defaults to the task you touched last.
Paths are relative to the repository root. Settings live in .ai/config.
EOF
}

# ---------------------------------------------------------------- setup ----

root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run this inside a git repository (git init first)"
cd "$root"
root_phys="$(pwd -P)"
AI="$root/.ai"
TASKS="$AI/tasks"

CHECK_CMD=""
MAX_FILE_KB=200
MAX_TOTAL_KB=3000
PACK_EXCLUDE=""
PACK_ALLOW=""
# shellcheck disable=SC1091
if [ -f "$AI/config" ]; then . "$AI/config"; fi

now_iso()   { date -u +%Y-%m-%dT%H:%M:%SZ; }
has_head()  { git rev-parse --verify -q HEAD >/dev/null 2>&1; }
have_bd()   { command -v bd >/dev/null 2>&1 && [ -d "$root/.beads" ]; }

valid_id() { case "${1:-}" in ''|*[!A-Za-z0-9._-]*|.*|-*) return 1;; *) return 0;; esac; }

task_template() { # dir title full(1|0)
  if [ "$3" -eq 1 ]; then
    cat > "$1/task.md" <<EOF
# $2

## Goal
What should be true when this is done?

## Constraints
Versions, standards, naming, things that must not change.

## Acceptance criteria
1.

## Notes for the model
Decisions already made, and anything it cannot see from the repository.
EOF
  else
    cat > "$1/task.md" <<EOF
# Notes for $2

The bead's title, description and acceptance criteria are added to the
context automatically. Put anything extra for the model here: decisions
already made, constraints, and things it cannot see from the repository.
EOF
  fi
}

adopt_bead() { # id -> creates the task folder for an existing bead
  local id="$1" dir="$TASKS/$1" title
  mkdir -p "$dir"
  title="$(bd show "$id" --json 2>/dev/null | sed -n 's/^ *"title": "\(.*\)",\{0,1\}$/\1/p' | head -1)"
  task_template "$dir" "${title:-$id}" 0
  log_event "$dir" new "${title:-$id}"
}

is_task_arg() { # true when the argument names a task rather than a path
  valid_id "${1:-}" || return 1
  [ -d "$TASKS/$1" ] && return 0
  [ -e "$1" ] && return 1
  have_bd && bd show "$1" >/dev/null 2>&1
}

resolve_task() { # prints the task folder; adopts a bead that has no folder yet
  local id="${1:-}" latest
  mkdir -p "$TASKS"
  if [ -z "$id" ]; then
    latest="$(ls -t "$TASKS"/*/events.tsv 2>/dev/null | head -1 || true)"
    [ -n "$latest" ] || die "no tasks yet. Run: ai-task new \"<title>\" or ai-task next"
    dirname "$latest"; return
  fi
  valid_id "$id" || die "not a valid task id: $id"
  if [ ! -d "$TASKS/$id" ]; then
    have_bd && bd show "$id" >/dev/null 2>&1 || die "task not found: $id. Run: ai-task status"
    adopt_bead "$id"
  fi
  echo "$TASKS/$id"
}

log_event() { # dir event detail
  printf '%s\t%s\t%s\t%s\n' "$(now_iso)" "$(date +%s)" "$2" "${3:-}" >> "$1/events.tsv"
}

count_events() { # dir event-prefix
  [ -f "$1/events.tsv" ] || { echo 0; return; }
  awk -F'\t' -v e="$2" 'index($3, e) == 1 { n++ } END { print n + 0 }' "$1/events.tsv"
}

clip_copy() {
  if command -v pbcopy >/dev/null 2>&1; then pbcopy
  elif command -v clip.exe >/dev/null 2>&1; then clip.exe
  elif command -v wl-copy >/dev/null 2>&1; then wl-copy
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard
  else return 1; fi
}

clip_paste() {
  if command -v pbpaste >/dev/null 2>&1; then pbpaste
  elif command -v powershell.exe >/dev/null 2>&1; then powershell.exe -NoProfile -Command Get-Clipboard
  elif command -v wl-paste >/dev/null 2>&1; then wl-paste
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard -o
  else return 1; fi
}

# ----------------------------------------------------------------- init ----

cmd_init() {
  mkdir -p "$TASKS"
  if [ ! -f "$AI/config" ]; then
    cat > "$AI/config" <<'EOF'
# ai-task settings. This file is sourced by bash.

# Command that proves a change works. Runs from the repository root.
# Examples:
#   CHECK_CMD="make test"
#   CHECK_CMD="npm test && npm run lint"
#   CHECK_CMD="packer init . && packer fmt -check -recursive . && packer validate ."
CHECK_CMD=""

# Limits for context.md.
MAX_FILE_KB=200
MAX_TOTAL_KB=3000

# Extra glob patterns to keep out of context.md (space separated), and
# patterns to let through even though the built-in secret filter matches them.
PACK_EXCLUDE=""
PACK_ALLOW=""
EOF
  fi
  if [ ! -f "$AI/.gitignore" ]; then
    printf '%s\n' '# context bundles are large and can be regenerated' 'tasks/*/context.md' > "$AI/.gitignore"
  fi
  echo "Initialized $AI"
  if command -v bd >/dev/null 2>&1; then
    [ -d "$root/.beads" ] && echo "Beads: found .beads/, tasks will be beads." \
      || echo "Beads: bd is installed but this repository has no .beads/. Run 'bd init' to track tasks as beads."
  else
    echo "Beads: bd is not installed, so tasks will get local ids."
  fi
  echo "Next: set CHECK_CMD in .ai/config, then: ai-task new \"<title>\""
}

# ------------------------------------------------------------------ new ----

cmd_new() {
  local title="" type="task" prio="2" id dir
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -t) type="${2:-}"; shift;;
      -p) prio="${2:-}"; shift;;
      *)  title="$1";;
    esac
    shift
  done
  [ -n "$title" ] || die "usage: ai-task new \"<title>\" [-t type] [-p priority]"
  [ -d "$TASKS" ] || cmd_init >/dev/null
  if have_bd; then
    id="$(bd create "$title" -t "$type" -p "$prio" --silent)" || die "bd create failed"
  else
    id="local-$(printf '%s%s%s' "$title" "$(date +%s)" "$RANDOM" | cksum | awk '{ printf "%04x", $1 % 65536 }')"
  fi
  valid_id "$id" || die "unexpected task id from bd: $id"
  dir="$TASKS/$id"
  mkdir -p "$dir"
  task_template "$dir" "$title" 1
  log_event "$dir" new "$title"
  echo "Created $id  (${dir#"$root"/})"
  echo "Next: edit task.md, then: ai-task pack $id"
}

# ------------------------------------------------------------ plan/next ----

need_bd() { have_bd || die "this needs Beads: install bd and run 'bd init' in this repository"; }

cmd_plan() {
  local file="${1:-}"
  [ -f "$file" ] || die "usage: ai-task plan <plan.json>"
  need_bd
  echo "Creating beads from $file"
  bd create --graph "$file" --json || die "bd rejected the plan file"
  echo
  echo "Next: bd ready   (shows what can be started), then: ai-task next"
}

cmd_next() {
  need_bd
  local id
  id="$(bd ready --json 2>/dev/null | sed -n 's/^ *"id": "\(.*\)",\{0,1\}$/\1/p' | head -1)"
  [ -n "$id" ] || die "no ready beads. Check: bd list"
  bd update "$id" --claim >/dev/null 2>&1 || note "could not claim $id (continuing)"
  local dir; dir="$(resolve_task "$id")"
  log_event "$dir" claim ""
  echo "Claimed $id: $(sed -n '1s/^# Notes for //p;1s/^# //p' "$dir/task.md" | head -1)"
  case "$(git symbolic-ref --short -q HEAD || true)" in
    ai/*) note "you are still on $(git symbolic-ref --short HEAD). Merge it and switch back to your main branch first, or this task will be stacked on top of it";;
  esac
  echo "Next: ai-task pack $id"
}

# ----------------------------------------------------------------- pack ----

is_sensitive_name() {
  local p="$1" pat
  for pat in $PACK_ALLOW; do
    # shellcheck disable=SC2254
    case "$p" in $pat) return 1;; esac
  done
  case "$p" in
    .env|.env.*|*/.env|*/.env.*|*.pem|*.key|*.p12|*.pfx|*.jks|*.keystore) return 0;;
    *.tfstate|*.tfstate.*|*.tfvars|*.tfvars.json|*.pkrvars.hcl|*.pkrvars.json) return 0;;
    *id_rsa*|*id_ed25519*|*.netrc|*.npmrc|*.pypirc|*credentials*|*secret*|*.kdbx) return 0;;
  esac
  for pat in $PACK_EXCLUDE; do
    # shellcheck disable=SC2254
    case "$p" in $pat) return 0;; esac
  done
  return 1
}

has_secret_content() {
  grep -Eq -e 'AKIA[0-9A-Z]{16}' -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' \
           -e 'gh[pousr]_[A-Za-z0-9]{36}' -e 'xox[baprs]-[A-Za-z0-9-]{10,}' "$1" 2>/dev/null
}

response_format() {
  cat <<'EOF'
## Response format

Reply with a short explanation of what you changed and why. Then put ALL file
changes in ONE code block fenced with four backticks, using exactly these
marker lines:

=== FILE: relative/path/from/repo/root ===
<the complete new content of the file>
=== END FILE ===

=== DELETE: relative/path/from/repo/root ===

Rules:
- Give the complete content of every file you create or change. No fragments,
  no diffs, no "rest unchanged" placeholders: the file is written exactly as sent.
- Include only files you are creating, changing or deleting.
- Put nothing else inside that code block.
- After the block, list the commands to run to verify the change. A person
  reviews and runs them; nothing you write is executed automatically.
- If you need a file that is listed as omitted, or anything else you cannot
  see, ask for it by path instead of guessing.
EOF
}

cmd_pack() {
  local dir n="" review=0 a
  local -a rest=()
  for a in "$@"; do
    if [ "$a" = "--review" ]; then review=1; else rest+=("$a"); fi
  done
  set -- ${rest[@]+"${rest[@]}"}
  if is_task_arg "${1:-}"; then n="$1"; shift; fi
  dir="$(resolve_task "$n")"
  local out="$dir/context.md" task; task="$(basename "$dir")"
  local max_file=$((MAX_FILE_KB * 1024)) max_total=$((MAX_TOTAL_KB * 1024))
  local list omitted total=0 included=0 f size
  list="$(mktemp)"; omitted="$(mktemp)"

  if [ "$#" -gt 0 ]; then
    git ls-files -co --exclude-standard -- "$@" > "$list" || true
    [ -s "$list" ] || note "warning: no files matched: $*"
  else
    git ls-files -co --exclude-standard > "$list"
  fi

  {
    echo "# AI TASK CONTEXT"
    echo
    echo "Task: $task"
    echo "Repository: $(basename "$root")"
    echo "Branch: $(git symbolic-ref --short -q HEAD || echo detached)"
    if has_head; then echo "Commit: $(git rev-parse --short HEAD)"; else echo "Commit: none yet (new repository)"; fi
    echo "Generated: $(now_iso)"
    echo "Check command: ${CHECK_CMD:-not configured}"
    echo
    echo "This file was produced by ai-task. It contains the task, the repository"
    echo "files you may need, and the format your reply must use."
    echo
    echo "## Task"
    echo
    if have_bd && bd show "$task" >/dev/null 2>&1; then
      echo "### Bead $task (from the issue tracker)"
      echo
      bd show "$task" 2>/dev/null | sed 's/[[:space:]]*$//' | cat -s
      echo
      echo "### Notes"
      echo
    fi
    cat "$dir/task.md"
    echo
    echo "## Repository file list"
    echo
    git ls-files -co --exclude-standard | grep -v -e '^\.ai/' -e '^\.beads' | sed 's/^/- /' || true
    echo
    echo "## Files"
    echo
    while IFS= read -r f; do
      case "$f" in .ai/*|.beads/*|.beads.*) continue;; esac
      [ -f "$f" ] || continue
      if is_sensitive_name "$f"; then echo "$f (name matches the secret filter)" >> "$omitted"; continue; fi
      if [ -s "$f" ] && ! grep -Iq . "$f"; then echo "$f (binary)" >> "$omitted"; continue; fi
      size="$(wc -c < "$f" | tr -d ' ')"
      if [ "$size" -gt "$max_file" ]; then echo "$f (larger than ${MAX_FILE_KB} KB)" >> "$omitted"; continue; fi
      if has_secret_content "$f"; then echo "$f (looks like it contains a credential)" >> "$omitted"; continue; fi
      if [ $((total + size)) -gt "$max_total" ]; then echo "$f (bundle size limit reached)" >> "$omitted"; continue; fi
      total=$((total + size)); included=$((included + 1))
      echo "===== FILE: $f ====="
      cat "$f"
      [ -z "$(tail -c1 "$f")" ] || echo
      echo "===== END FILE ====="
      echo
    done < "$list"
    if [ -s "$omitted" ]; then
      echo "## Omitted files"
      echo
      echo "These exist but their content is not included. Ask if you need one."
      echo
      sed 's/^/- /' "$omitted"
      echo
    fi
    if has_head && ! git diff --quiet HEAD -- . ':!.ai' 2>/dev/null; then
      echo "## Uncommitted changes (git diff HEAD)"
      echo
      git diff HEAD -- . ':!.ai'
      echo
    fi
    if [ -f "$dir/base" ] && has_head; then
      local base; base="$(cat "$dir/base")"
      if git rev-parse --verify -q "$base" >/dev/null && ! git diff --quiet "$base"...HEAD -- . ':!.ai'; then
        echo "## Changes on this task branch (git diff $base...HEAD)"
        echo
        git diff "$base"...HEAD -- . ':!.ai'
        echo
      fi
    fi
    if [ -f "$dir/check.log" ]; then
      echo "## Last check output (tail)"
      echo
      tail -n 150 "$dir/check.log"
      echo
    fi
    if [ "$review" -eq 1 ]; then
      echo "## Requested output"
      echo
      echo "Review the changes shown in the diff sections above against the task."
      echo "Do not rewrite the code. Reply with a review report: a verdict, then"
      echo "blocking findings, should-fix findings, and nits, each with file and line."
    else
      response_format
    fi
  } > "$out"

  local n_omitted; n_omitted="$(wc -l < "$omitted" | tr -d ' ')"
  log_event "$dir" pack "files=$included omitted=$n_omitted bytes=$(wc -c < "$out" | tr -d ' ')"
  echo "Wrote ${out#"$root"/}  ($included files, $(( $(wc -c < "$out") / 1024 )) KB)"
  if [ "$n_omitted" -gt 0 ]; then
    echo "Omitted $n_omitted file(s):"; sed 's/^/  /' "$omitted"
  fi
  if [ "$review" -eq 1 ]; then
    echo "Next: read it over, then upload it to the chat with /pr-review."
  else
    echo "Next: read it over, upload it to the chat with a skill (for example /implement-with-tests),"
    echo "      copy the reply's code block, then: ai-task apply --paste"
  fi
  rm -f "$list" "$omitted"
}

# ---------------------------------------------------------------- apply ----

safe_path() { # prints reason and returns 1 if the path must not be written
  local p="$1" d
  case "$p" in
    '')                   echo "empty path"; return 1;;
    /*|[A-Za-z]:*|*\\*)   echo "absolute or Windows-style path"; return 1;;
    ..|../*|*/../*|*/..)  echo "path leaves the repository"; return 1;;
    .git|.git/*|*/.git/*) echo "inside .git"; return 1;;
    .ai|.ai/*)            echo "inside .ai (reserved for ai-task)"; return 1;;
    .beads|.beads/*|.beads.*) echo "inside .beads (issue tracker data)"; return 1;;
  esac
  if [ -L "$p" ]; then echo "is a symlink"; return 1; fi
  d="$(dirname "$p")"
  while [ ! -d "$d" ] && [ "$d" != "." ]; do d="$(dirname "$d")"; done
  case "$(cd "$d" && pwd -P)/" in
    "$root_phys"/*) return 0;;
    *) echo "resolves outside the repository"; return 1;;
  esac
}

cmd_apply() {
  local n="" src="" commit=1 paste=0 dir
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --paste) paste=1;;
      --no-commit) commit=0;;
      -) src="-";;
      *) if [ -z "$n" ] && is_task_arg "$1"; then n="$1"; else src="$1"; fi;;
    esac
    shift
  done
  dir="$(resolve_task "$n")"
  local task; task="$(basename "$dir")"
  has_head || die "make an initial commit first (for example a README), so changes can be reviewed and undone"
  if [ -n "$(git status --porcelain --untracked-files=no -- . ':!.ai')" ]; then
    die "uncommitted changes in the working tree. Commit or stash them first, so the model's changes stay separate from yours"
  fi

  local round; round=$(( $(count_events "$dir" apply) + 1 ))
  local saved; saved="$dir/response-$(printf '%02d' "$round").txt"
  if [ "$paste" -eq 1 ]; then
    clip_paste > "$saved" || die "no clipboard tool found. Save the reply to a file and pass its path"
  elif [ "$src" = "-" ]; then
    cat > "$saved"
  elif [ -n "$src" ]; then
    [ -f "$src" ] || die "file not found: $src"
    cp "$src" "$saved"
  elif [ -f "$dir/response.txt" ]; then
    mv "$dir/response.txt" "$saved"
  else
    die "no input. Use --paste, a file path, - for stdin, or save the reply as ${dir#"$root"/}/response.txt"
  fi

  local stage; stage="$(mktemp -d)"
  tr -d '\r' < "$saved" | awk -v stage="$stage" '
    function trim(s) { gsub(/^[ \t`]+|[ \t`]+$/, "", s); return s }
    /^=== FILE: .* ===[ \t]*$/ {
      if (infile) { print "E\tunclosed file block: " path > (stage "/manifest") }
      path = $0; sub(/^=== FILE: /, "", path); sub(/ ===[ \t]*$/, "", path); path = trim(path)
      count++; content = sprintf("%s/%04d", stage, count); printf "" > content
      infile = 1; next
    }
    /^=== END FILE ===[ \t]*$/ {
      if (infile) { print "W\t" path "\t" content > (stage "/manifest"); close(content); infile = 0 }
      next
    }
    /^=== DELETE: .* ===[ \t]*$/ && !infile {
      path = $0; sub(/^=== DELETE: /, "", path); sub(/ ===[ \t]*$/, "", path)
      print "D\t" trim(path) > (stage "/manifest"); next
    }
    infile { print > content }
    END { if (infile) print "E\tunclosed file block: " path > (stage "/manifest") }
  '
  [ -s "$stage/manifest" ] || { rm -rf "$stage"; die "no '=== FILE: ... ===' blocks found in the reply. Copy the whole code block from the chat"; }

  # Validate everything before touching the working tree.
  local kind path content reason bad=0
  while IFS="$(printf '\t')" read -r kind path content; do
    if [ "$kind" = "E" ]; then note "rejected: $path"; bad=1; continue; fi
    if ! reason="$(safe_path "$path")"; then note "rejected: $path ($reason)"; bad=1; fi
  done < "$stage/manifest"
  [ "$bad" -eq 0 ] || { rm -rf "$stage"; die "nothing was changed. The reply is saved at ${saved#"$root"/}"; }

  local branch cur; cur="$(git symbolic-ref --short -q HEAD || true)"
  branch="ai/$task"
  if [ "$cur" != "$branch" ]; then
    [ -f "$dir/base" ] || echo "${cur:-$(git rev-parse --short HEAD)}" > "$dir/base"
    if git rev-parse --verify -q "refs/heads/$branch" >/dev/null; then git checkout -q "$branch"
    else git checkout -q -b "$branch"; fi
  fi

  local written=0 deleted=0
  while IFS="$(printf '\t')" read -r kind path content; do
    case "$kind" in
      W) mkdir -p "$(dirname "$path")"; cp "$content" "$path"; git add -- "$path"; written=$((written + 1));;
      D) if [ -e "$path" ]; then
           rm -f "$path"; git add -A -- "$path" 2>/dev/null || true; deleted=$((deleted + 1))
         else note "delete skipped, not found: $path"; fi;;
    esac
  done < "$stage/manifest"
  rm -rf "$stage"

  echo "Applied round $round on branch $branch: $written written, $deleted deleted"
  git diff --cached --stat
  if git diff --cached --quiet; then
    note "the reply made no changes to the repository"
  elif [ "$commit" -eq 1 ]; then
    git commit -q -m "ai-task $task round $round: model output (unreviewed)" \
                  -m "Applied by ai-task from ${saved#"$root"/}. Review before merging."
    echo "Committed as $(git rev-parse --short HEAD). Undo with: git reset --hard HEAD~1"
  fi
  log_event "$dir" apply "round=$round written=$written deleted=$deleted"
  echo "Next: review with 'git show', then: ai-task check"
}

# ---------------------------------------------------------------- check ----

cmd_check() {
  local n="" cmd="" dir
  if [ "${1:-}" != "--" ] && is_task_arg "${1:-}"; then n="$1"; shift; fi
  if [ "${1:-}" = "--" ]; then shift; cmd="$*"; fi
  dir="$(resolve_task "$n")"
  [ -n "$cmd" ] || cmd="$CHECK_CMD"
  [ -n "$cmd" ] || die "no check command. Set CHECK_CMD in .ai/config or run: ai-task check -- <command>"
  local log="$dir/check.log" rc
  { echo "\$ $cmd"; echo "# $(now_iso)"; } > "$log"
  set +e
  bash -c "$cmd" 2>&1 | tee -a "$log"
  rc="${PIPESTATUS[0]}"
  set -e
  echo "# exit code: $rc" >> "$log"
  if [ "$rc" -eq 0 ]; then
    log_event "$dir" check-pass "$cmd"
    echo "PASS. Review the branch, merge it yourself when you are satisfied, then: ai-task done"
  else
    log_event "$dir" check-fail "rc=$rc $cmd"
    echo "FAIL (exit $rc). Next: ai-task feedback --copy, and paste it into the same chat."
  fi
  return 0
}

# ------------------------------------------------------------- feedback ----

cmd_feedback() {
  local n="" copy=0 dir
  while [ "$#" -gt 0 ]; do
    case "$1" in --copy) copy=1;; *) n="$1";; esac
    shift
  done
  dir="$(resolve_task "$n")"
  [ -f "$dir/check.log" ] || die "no check.log yet. Run: ai-task check"
  local out="$dir/feedback.md"
  {
    echo "# AI TASK FEEDBACK"
    echo
    echo "Task: $(basename "$dir")   Round: $(count_events "$dir" apply)"
    echo
    echo "Your last change bundle was applied. The check below was then run."
    echo "Find the cause, fix it, and reply in the same format as before:"
    echo "complete files inside one four-backtick code block with"
    echo "'=== FILE: path ===' / '=== END FILE ===' markers. Send only the files"
    echo "that need to change. If the check itself is wrong, say so instead."
    echo
    echo "## Check output"
    echo
    echo '```'
    head -n 2 "$dir/check.log"
    local lines; lines="$(wc -l < "$dir/check.log" | tr -d ' ')"
    if [ "$lines" -gt 202 ]; then echo "... ($((lines - 202)) lines omitted) ..."; fi
    tail -n +3 "$dir/check.log" | tail -n 200
    echo '```'
  } > "$out"
  log_event "$dir" feedback ""
  echo "Wrote ${out#"$root"/}"
  if [ "$copy" -eq 1 ]; then
    if clip_copy < "$out"; then echo "Copied to the clipboard."; else note "no clipboard tool found; open the file and copy it"; fi
  fi
}

# ----------------------------------------------------------------- done ----

cmd_done() {
  local n="" reason="" force=0 dir id
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force=1;;
      *) if [ -z "$n" ] && is_task_arg "$1"; then n="$1"; else reason="$1"; fi;;
    esac
    shift
  done
  dir="$(resolve_task "$n")"; id="$(basename "$dir")"
  local last; last="$(awk -F'\t' 'index($3, "check-") == 1 { l = $3 } END { print l }' "$dir/events.tsv")"
  if [ "$last" != "check-pass" ] && [ "$force" -eq 0 ]; then
    die "the last check for $id did not pass (${last:-no check run}). Fix it, or use --force"
  fi
  [ -n "$reason" ] || reason="Checks passed after $(count_events "$dir" apply) round(s) via ai-task"
  if have_bd && bd show "$id" >/dev/null 2>&1; then
    bd close "$id" --reason "$reason" || die "bd close failed"
  fi
  log_event "$dir" done "$reason"
  echo "Closed $id."
  have_bd && echo "Next: ai-task next" || true
}

# -------------------------------------------------------- status/report ----

each_task() { ls -tr "$TASKS"/*/events.tsv 2>/dev/null | sed 's#/events.tsv$##' || true; }

cmd_status() {
  local d last
  [ -n "$(each_task)" ] || { echo "No tasks. Run: ai-task new \"<title>\""; return; }
  printf '%-18s %-7s %-11s %s\n' "TASK" "ROUNDS" "LAST CHECK" "TITLE"
  for d in $(each_task); do
    last="$(awk -F'\t' 'index($3, "check-") == 1 { l = $3 } END { print (l == "" ? "-" : substr(l, 7)) }' "$d/events.tsv" 2>/dev/null || echo -)"
    printf '%-18s %-7s %-11s %s\n' "$(basename "$d")" "$(count_events "$d" apply)" "$last" \
      "$(awk -F'\t' '$3 == "new" { print $4; exit }' "$d/events.tsv")"
  done
}

cmd_report() {
  local d
  [ -n "$(each_task)" ] || { echo "No tasks."; return; }
  echo "| Task | Rounds | Checks failed | Passed | Minutes to first pass |"
  echo "|---|---|---|---|---|"
  for d in $(each_task); do
    [ -f "$d/events.tsv" ] || continue
    awk -F'\t' -v t="$(basename "$d")" '
      $3 == "new" { start = $2 }
      $3 == "apply" { rounds++ }
      $3 == "check-fail" { fails++ }
      $3 == "check-pass" { if (!pass) pass = $2 }
      END {
        mins = (pass && start) ? sprintf("%.0f", (pass - start) / 60) : "-"
        printf "| %s | %d | %d | %s | %s |\n", t, rounds, fails, (pass ? "yes" : "no"), mins
      }' "$d/events.tsv"
  done
  echo
  for d in $(each_task); do [ -f "$d/events.tsv" ] && cat "$d/events.tsv"; done | awk -F'\t' '
    $3 == "new" { tasks++; r = 0; done = 0 }
    $3 == "apply" { r++ }
    $3 == "check-pass" && !done { done = 1; passed++; if (r <= 1) first++ }
    END { printf "Tasks: %d. Passed: %d. Passed on the first round: %d.\n", tasks, passed, first }'
}

# ----------------------------------------------------------------- main ----

cmd="${1:-help}"; [ "$#" -gt 0 ] && shift
case "$cmd" in
  init)     cmd_init "$@";;
  new)      cmd_new "$@";;
  plan)     cmd_plan "$@";;
  next)     cmd_next "$@";;
  done)     cmd_done "$@";;
  pack)     cmd_pack "$@";;
  apply)    cmd_apply "$@";;
  check)    cmd_check "$@";;
  feedback) cmd_feedback "$@";;
  status)   cmd_status "$@";;
  report)   cmd_report "$@";;
  version|--version) echo "ai-task $VERSION";;
  help|-h|--help) usage;;
  *) usage; exit 1;;
esac
